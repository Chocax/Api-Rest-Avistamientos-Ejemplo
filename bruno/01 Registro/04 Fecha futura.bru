meta {
  name: Fecha futura
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/avistamientos
  body: json
  auth: none
}

body:json {
  {
    "especie": "Mirla",
    "lugar": "Usaquén",
    "fecha": "2999-12-31",
    "observador": "Santiago"
  }
}

tests {
  test("responde 400 indicando el campo fecha", function () {
    expect(res.status).to.equal(400);
    expect(res.body.campo).to.equal('fecha');
    expect(res.body.mensaje).to.be.a('string').and.not.empty;
  });

  test("explica que no puede ser posterior a hoy", function () {
    expect(res.body.mensaje).to.contain("posterior a hoy");
  });
}

docs {
  La fecha no puede ser posterior a hoy.
}

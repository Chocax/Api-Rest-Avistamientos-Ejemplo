meta {
  name: Observador vacio
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/avistamientos
  body: json
  auth: none
}

body:json {
  {
    "especie": "Mirla",
    "lugar": "Usaquén",
    "fecha": "2026-09-29",
    "observador": ""
  }
}

tests {
  test("responde 400 indicando el campo observador", function () {
    expect(res.status).to.equal(400);
    expect(res.body.campo).to.equal('observador');
    expect(res.body.mensaje).to.be.a('string').and.not.empty;
  });

}

docs {
  El observador es obligatorio.
}

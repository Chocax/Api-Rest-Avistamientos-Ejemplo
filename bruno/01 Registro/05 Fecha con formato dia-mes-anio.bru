meta {
  name: Fecha con formato dia-mes-anio
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/avistamientos
  body: json
  auth: none
}

body:json {
  {
    "especie": "Mirla",
    "lugar": "Usaquén",
    "fecha": "21/10/2026",
    "observador": "Santiago"
  }
}

tests {
  test("responde 400 indicando el campo fecha", function () {
    expect(res.status).to.equal(400);
    expect(res.body.campo).to.equal('fecha');
    expect(res.body.mensaje).to.be.a('string').and.not.empty;
  });

}

docs {
  La fecha debe venir como AAAA-MM-DD.
}

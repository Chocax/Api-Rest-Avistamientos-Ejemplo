meta {
  name: Especie de 2 caracteres
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/avistamientos
  body: json
  auth: none
}

body:json {
  {
    "especie": "Ab",
    "lugar": "Usaquén",
    "fecha": "2026-09-29",
    "observador": "Santiago"
  }
}

tests {
  test("responde 400 indicando el campo especie", function () {
    expect(res.status).to.equal(400);
    expect(res.body.campo).to.equal('especie');
    expect(res.body.mensaje).to.be.a('string').and.not.empty;
  });

  test("explica el rango permitido", function () {
    expect(res.body.mensaje).to.contain("entre 3 y 50");
  });
}

docs {
  Valor límite: la especie debe tener entre 3 y 50 caracteres.
}

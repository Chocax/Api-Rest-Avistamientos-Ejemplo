meta {
  name: Obtener por id
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/avistamientos/{{idCreado}}
  body: none
  auth: none
}

tests {
  test("responde 200 con todos los campos", function () {
    expect(res.status).to.equal(200);
    expect(res.body.id).to.equal(bru.getVar("idCreado"));
    expect(res.body.especie).to.equal('Colibrí');
    expect(res.body.lugar).to.equal('Cerros Orientales');
    expect(res.body.fecha).to.equal('2026-09-29');
    expect(res.body.observador).to.equal('Santiago');
  });
}
